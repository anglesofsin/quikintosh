RowLayout{Layout.fillWidth:true
 Text{text:'Color composition';color:Theme.textPrimary;Layout.fillWidth:true}
 TahoeCombo{model:['Single color','Left & right','Top & bottom','Diagonal','Stripes','Three colors'];currentIndex:Math.max(0,['single','horizontal','vertical','diagonal','stripes','trio'].indexOf(root.entry.clockColorLayout || 'single'));onActivated:i=>WidgetState.configure(WidgetState.editingZone,WidgetState.editingId,{clockColorLayout:['single','horizontal','vertical','diagonal','stripes','trio'][i]})}
}
ConfigSwitch{visible:(root.entry.clockColorLayout || 'single')!=='single';text:'Use wallpaper palette';checked:root.entry.clockPartPalette!==false;onToggled:v=>WidgetState.configure(WidgetState.editingZone,WidgetState.editingId,{clockPartPalette:v})}
ColorSetting{visible:(root.entry.clockColorLayout || 'single')!=='single' && root.entry.clockPartPalette===false;label:'First color';value:root.entry.clockPartFirst || '#ffb6ce';onPicked:v=>WidgetState.configure(WidgetState.editingZone,WidgetState.editingId,{clockPartFirst:String(v)})}
ColorSetting{visible:(root.entry.clockColorLayout || 'single')!=='single' && root.entry.clockPartPalette===false;label:'Second color';value:root.entry.clockPartSecond || '#89cfff';onPicked:v=>WidgetState.configure(WidgetState.editingZone,WidgetState.editingId,{clockPartSecond:String(v)})}
ColorSetting{visible:root.entry.clockColorLayout==='trio' && root.entry.clockPartPalette===false;label:'Third color';value:root.entry.clockPartThird || '#e6caff';onPicked:v=>WidgetState.configure(WidgetState.editingZone,WidgetState.editingId,{clockPartThird:String(v)})}
ConfigSlider{visible:['horizontal','vertical','diagonal','stripes'].includes(root.entry.clockColorLayout || 'single');text:'Color division';from:.05;to:.95;decimals:2;value:root.entry.clockPartSplit ?? .5;onMoved:v=>WidgetState.configure(WidgetState.editingZone,WidgetState.editingId,{clockPartSplit:v})}
ConfigSlider{visible:(root.entry.clockColorLayout || 'single')!=='single';text:'Color blending';from:0;to:.5;decimals:2;value:root.entry.clockPartSoftness ?? 0;onMoved:v=>WidgetState.configure(WidgetState.editingZone,WidgetState.editingId,{clockPartSoftness:v})}
